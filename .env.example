# Copy to .env for local dev, or set these in Vercel (Settings > Environment Variables).
ANTHROPIC_API_KEY=
# Optional: defaults to claude-opus-5-5
ANTHROPIC_MODEL=
# Optional: if set, visitors must enter this code before the live facilitator answers
ACCESS_CODE=
# Optional: secret for signing stage-progress tokens (defaults to a key derived from ANTHROPIC_API_KEY)
PROGRESS_SECRET=
